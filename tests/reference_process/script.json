{
  "name": "acme-reference-v1",
  "description": "Deterministic ~30-step reference process for Gate 0. Ground truth below is hand-written; the driver never derives it from capture output. Canaries: a seeded password and a seeded card number that must appear in NO persisted artifact.",
  "canaries": ["hunter2-Xk9-SEEDED-SECRET", "4111111111111111"],
  "steps": [
    { "op": "goto", "path": "/login.html" },
    { "op": "fill", "selector": "#username", "value": "opsuser" },
    { "op": "fill", "selector": "#password", "value": "hunter2-Xk9-SEEDED-SECRET" },
    { "op": "click", "selector": "#sign-in",
      "wait_response": { "method": "POST", "path": "/api/login" },
      "wait_nav": "**/orders.html" },
    { "op": "fill", "selector": "#customer", "value": "Globex Corporation" },
    { "op": "fill", "selector": "#quantity", "value": "12" },
    { "op": "press", "selector": "#quantity", "key": "Tab" },
    { "op": "click", "selector": "#add-line" },
    { "op": "fill", "selector": "#sku-1", "value": "SKU-1001" },
    { "op": "click", "selector": "#add-line" },
    { "op": "fill", "selector": "#sku-2", "value": "SKU-2002" },
    { "op": "fill", "selector": "#shipping", "value": "12 Harbor Way, Dock 4" },
    { "op": "fill", "selector": "#billing", "value": "99 Ledger Street" },
    { "op": "fill", "selector": "#email", "value": "ops@globex.example" },
    { "op": "fill", "selector": "#card-number", "value": "4111111111111111" },
    { "op": "fill", "selector": "#notes", "value": "Fragile - deliver to dock 4" },
    { "op": "fill", "selector": "#discount-code", "value": "SAVE10" },
    { "op": "click", "selector": "#apply-discount",
      "wait_response": { "method": "GET", "path": "/api/discount" } },
    { "op": "click", "selector": "#create-order",
      "wait_response": { "method": "GET", "path": "/api/orders/" } },
    { "op": "click", "selector": "#done" },
    { "op": "click", "selector": "#log-out",
      "wait_response": { "method": "POST", "path": "/api/logout" },
      "wait_nav": "**/login.html" }
  ],
  "expected_events": [
    { "kind": "navigate", "path": "/login.html" },
    { "kind": "input", "name": "Username", "value": "opsuser" },
    { "kind": "input", "name": "Password", "value": null },
    { "kind": "click", "name": "Sign in" },
    { "kind": "network", "method": "POST", "path": "/api/login", "status": 200 },
    { "kind": "navigate", "path": "/orders.html" },
    { "kind": "input", "name": "Customer name", "value": "Globex Corporation" },
    { "kind": "input", "name": "Quantity", "value": "12" },
    { "kind": "key", "keys": "Tab" },
    { "kind": "click", "name": "Add line" },
    { "kind": "input", "name": "Item SKU 1", "value": "SKU-1001" },
    { "kind": "click", "name": "Add line" },
    { "kind": "input", "name": "Item SKU 2", "value": "SKU-2002" },
    { "kind": "input", "name": "Shipping address", "value": "12 Harbor Way, Dock 4" },
    { "kind": "input", "name": "Billing address", "value": "99 Ledger Street" },
    { "kind": "input", "name": "Contact email", "value": "ops@globex.example" },
    { "kind": "input", "name": "Card number", "value": "{redacted}" },
    { "kind": "input", "name": "Notes", "value": "Fragile - deliver to dock 4" },
    { "kind": "input", "name": "Discount code", "value": "SAVE10" },
    { "kind": "click", "name": "Apply discount" },
    { "kind": "network", "method": "GET", "path": "/api/discount", "status": 200 },
    { "kind": "click", "name": "Create order" },
    { "kind": "network", "method": "POST", "path": "/api/orders", "status": 201 },
    { "kind": "network", "method": "GET", "path": "/api/orders/{p0}", "status": 200 },
    { "kind": "click", "name": "Done" },
    { "kind": "click", "name": "Log out" },
    { "kind": "network", "method": "POST", "path": "/api/logout", "status": 200 },
    { "kind": "navigate", "path": "/login.html" }
  ]
}
