{
  "scenario": "s6_volatile_ids",
  "description": "Session ids in frame URLs, timestamps in query params, order numbers in accessible names: identical process that naive canonicalization would over-segment.",
  "runs": [
    "s6-run1.ndjson",
    "s6-run2.ndjson"
  ],
  "expected_columns": [
    {
      "token": "navigate|||https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "input|textbox|Username|https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "click|button|Sign in|https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/login",
      "class": "invariant"
    },
    {
      "token": "navigate|||https://orders.acme.test/orders?tab={tab}",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/orders",
      "class": "invariant"
    },
    {
      "token": "click|button|Open order ORD-{num}-{num}|https://orders.acme.test/orders?tab={tab}",
      "class": "invariant"
    },
    {
      "token": "input|textbox|PO number|https://orders.acme.test/orders?tab={tab}",
      "class": "parameterized"
    },
    {
      "token": "click|button|Save changes|https://orders.acme.test/orders?tab={tab}",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/orders/{p0}",
      "class": "parameterized"
    }
  ],
  "notes": "PO number stays parameterized: the normalizer must not strip genuine parameters."
}
