{
  "scenario": "s5_singleton",
  "description": "Session-expired banner dismissed in exactly one of three runs.",
  "runs": [
    "s5-run1.ndjson",
    "s5-run2.ndjson",
    "s5-run3.ndjson"
  ],
  "expected_columns": [
    {
      "token": "navigate|||https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "input|textbox|Username|https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "click|button|Sign in|https://orders.acme.test/login",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/login",
      "class": "invariant"
    },
    {
      "token": "navigate|||https://orders.acme.test/orders/new",
      "class": "invariant"
    },
    {
      "token": "click|button|Dismiss|https://orders.acme.test/orders/new",
      "class": "conditional"
    },
    {
      "token": "network|||https://orders.acme.test/api/session/refresh",
      "class": "conditional"
    },
    {
      "token": "input|textbox|Customer name|https://orders.acme.test/orders/new",
      "class": "invariant"
    },
    {
      "token": "click|button|Create order|https://orders.acme.test/orders/new",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/orders",
      "class": "invariant"
    },
    {
      "token": "network|||https://orders.acme.test/api/orders/{p0}",
      "class": "parameterized"
    },
    {
      "token": "click|button|Done|https://orders.acme.test/orders/new",
      "class": "invariant"
    }
  ],
  "notes": "Singleton variants feed the Good-Turing estimator downstream; here they must simply classify conditional, never invariant."
}
